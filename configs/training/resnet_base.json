{
  "name": "resnet_base",
  "description": "Base ResNet with skip connections (~250K parameters)",

  "network": {
    "type": "resnet_scalable",
    "width_mult": 1.0,
    "num_res_blocks": [2, 2, 2],
    "base_channels": 64,
    "fc_hidden_dims": [256, 128],
    "dropout": 0.2
  },

  "training": {
    "num_epochs": 100,
    "batch_size": 64,
    "learning_rate": 1e-4,
    "weight_decay": 1e-5,
    "patience": 15
  },

  "loss": {
    "type": "hybrid",
    "alpha": 0.5,
    "use_normalized_supervised_loss": true,
    "physics_loss_scale": 1.0,
    "param_weights": {
      "n": 1.0,
      "kappa": 1.0,
      "d": 1.0
    }
  },

  "dataset": {
    "name": "production_v1"
  },

  "precision": {
    "use_amp": true,
    "dtype": "float16",
    "grad_scaler": true
  }
}
