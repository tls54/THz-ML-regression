{
  "name": "cnn_large",
  "description": "Large CNN for high capacity (~3M parameters)",

  "network": {
    "type": "cnn_scalable",
    "width_mult": 1.5,
    "num_blocks": 5,
    "base_channels": 48,
    "fc_hidden_dims": [256, 128],
    "dropout": 0.3
  },

  "training": {
    "num_epochs": 100,
    "batch_size": 256,
    "learning_rate": 2e-4,
    "weight_decay": 1e-4,
    "patience": 15,
    "scheduler_patience": 10,
    "scheduler_factor": 0.5
  },

  "loss": {
    "type": "hybrid",
    "alpha": 0.5,
    "use_normalized_supervised_loss": true,
    "physics_loss_scale": 0.5,
    "param_weights": {
      "n": 1.0,
      "kappa": 1.0,
      "d": 1.0
    }
  },

  "dataset": {
    "name": "production_v1"
  },

  "precision": {
    "use_amp": false,
    "dtype": "float32",
    "grad_scaler": false
  }
}
