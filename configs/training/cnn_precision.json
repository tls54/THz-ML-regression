{
  "name": "cnn_precision",
  "description": "CNN optimized for precision - mag/phase physics loss, cosine LR, alpha scheduling",

  "network": {
    "type": "cnn_scalable",
    "width_mult": 1.0,
    "num_blocks": 4,
    "base_channels": 32,
    "fc_hidden_dims": [256, 128, 64],
    "dropout": 0.2,
    "activation": "gelu"
  },

  "training": {
    "num_epochs": 100,
    "batch_size": 64,
    "learning_rate": 1e-4,
    "weight_decay": 1e-5,
    "patience": 20,
    "lr_scheduler": "cosine",
    "cosine_eta_min": 1e-6,
    "grad_clip_norm": 1.0
  },

  "loss": {
    "type": "hybrid",
    "supervised_loss": "huber",
    "huber_delta": 0.1,
    "alpha": 0.7,
    "use_normalized_supervised_loss": true,
    "physics_loss_scale": 0.3,
    "physics_loss_mode": "mag_phase",
    "param_weights": {
      "n": 1.0,
      "kappa": 1.0,
      "d": 1.0
    },
    "physics_freq_min": 0.3e12,
    "physics_freq_max": 2.5e12,
    "alpha_schedule": {
      "enabled": true,
      "warmup_epochs": 30,
      "final_alpha": 0.3,
      "decay_epochs": 30
    }
  },

  "hardware": {
    "dtype": "float32"
  },

  "dataset": {
    "name": "production_v2"
  }
}
