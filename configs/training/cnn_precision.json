{
  "name": "cnn_precision",
  "description": "CNN optimized for precision - uses Huber loss, GELU activation, larger FC head",

  "network": {
    "type": "cnn_scalable",
    "width_mult": 1.0,
    "num_blocks": 4,
    "base_channels": 32,
    "fc_hidden_dims": [256, 128, 64],
    "dropout": 0.2,
    "activation": "gelu"
  },

  "training": {
    "num_epochs": 150,
    "batch_size": 256,
    "learning_rate": 1e-4,
    "weight_decay": 1e-5,
    "patience": 20,
    "scheduler_patience": 10,
    "scheduler_factor": 0.5,
    "grad_clip_norm": 1.0
  },

  "loss": {
    "type": "hybrid",
    "supervised_loss": "huber",
    "huber_delta": 0.1,
    "alpha": 0.7,
    "use_normalized_supervised_loss": true,
    "physics_loss_scale": 0.3,
    "param_weights": {
      "n": 1.0,
      "kappa": 1.0,
      "d": 1.0
    }
  },

  "hardware": {
    "dtype": "float32"
  },

  "dataset": {
    "name": "production_v1"
  }
}
