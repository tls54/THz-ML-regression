{
  "name": "cnn_base",
  "description": "Base CNN - recommended starting point (~200K parameters)",

  "network": {
    "type": "cnn_scalable",
    "width_mult": 1.0,
    "num_blocks": 4,
    "base_channels": 32,
    "fc_hidden_dims": [128, 64],
    "dropout": 0.2
  },

  "training": {
    "num_epochs": 100,
    "batch_size": 256,
    "learning_rate": 1e-4,
    "weight_decay": 1e-5,
    "patience": 15,
    "scheduler_patience": 10,
    "scheduler_factor": 0.5
  },

  "loss": {
    "type": "hybrid",
    "alpha": 0.5,
    "use_normalized_supervised_loss": true,
    "physics_loss_scale": 0.5,
    "param_weights": {
      "n": 1.0,
      "kappa": 1.0,
      "d": 1.0
    }
  },

  "dataset": {
    "name": "production_v1"
  }
}
